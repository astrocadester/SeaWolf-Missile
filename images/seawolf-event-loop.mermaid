%% seawolf-event-loop_v002_20260915.mermaid
%% Version .002 — 2026-09-15
%% Verified against Seawolf(1).asm: SEAWOLF_EVENT_LOOP, COMMON_DOIT_TABLE, SEAWOLF_DOIT_TABLE.
graph TD
    classDef upi fill:#7c2d12,stroke:#9a3412,stroke-width:2px,color:#fff;
    classDef handler fill:#9a3412,stroke:#b45309,stroke-width:2px,color:#fff;

    subgraph SEAWOLF_EVENT_LOOP
        A[DO SENTRY<br>ALKEYS $0214]:::upi --> B[DO DOIT<br>COMMON_DOIT_TABLE]:::upi
        B --> C{Common event matched?}

        C -->|SCT7| E1[QUIT_GAME]:::handler
        C -->|SCT4| E2[COUNTER4_EXPIRED<br>spawn target]:::handler
        C -->|SCT3| E3[COUNTER3_EXPIRED<br>spawn target]:::handler
        C -->|SF7| E4[PROJECTILE_STATUS_CHANGED]:::handler
        C -->|SF1| E5[SCORE_CHANGED]:::handler
        C -->|ST0| E6[TRIGGER0_CHANGED]:::handler
        C -->|ST1| E7[TRIGGER1_CHANGED]:::handler
        C -->|SSEC| E8[SECOND_ELAPSED]:::handler
        C -->|SKYD| E9[KEY_DOWN]:::handler
        C -->|No common match| D[DO DOIT<br>SEAWOLF_DOIT_TABLE]:::upi

        D --> F{Seawolf event matched?}
        F -->|SCT6| G1[SEAWOLF_COUNTER6_EXPIRED<br>player 2 torpedo launch]:::handler
        F -->|SCT5| G2[SEAWOLF_COUNTER5_EXPIRED<br>player 1 torpedo launch]:::handler
        F -->|SCT2| G3[SEAWOLF_COUNTER2_EXPIRED<br>player 2 load message]:::handler
        F -->|SCT1| G4[SEAWOLF_COUNTER1_EXPIRED<br>player 1 load message]:::handler
        F -->|SCT0| G5[SEAWOLF_COUNTER0_EXPIRED<br>refresh/init target objects]:::handler
        F -->|SF4| G6[SEAWOLF_FLAG4_CHANGED<br>clear player-2 shot flag / redraw indicators]:::handler
        F -->|SF3| G7[SEAWOLF_FLAG3_CHANGED<br>clear player-1 shot flag / redraw indicators]:::handler
        F -->|SP0| G8[SEAWOLF_POT0_CHANGED<br>move player 1 submarine]:::handler
        F -->|SP1| G9[SEAWOLF_POT1_CHANGED<br>move player 2 submarine]:::handler
        F -->|No match| H[DO MJUMP<br>SEAWOLF_EVENT_LOOP]:::upi

        E1 & E2 & E3 & E4 & E5 & E6 & E7 & E8 & E9 & G1 & G2 & G3 & G4 & G5 & G6 & G7 & G8 & G9 --> H
    end
