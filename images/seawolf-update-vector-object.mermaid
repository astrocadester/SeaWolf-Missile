%% UPDATE_VECTOR_OBJECT.mermaid
%% Version: 20260915-1015

flowchart TD
    A["UPDATE_VECTOR_OBJECT<br/>Called from IM2 object-update pipeline"] --> B["DEC HL"]
    B --> C{"BIT 7,(HL)?"}
    C -- "NZ" --> R1["RET"]
    C -- "clear" --> D["XOR A<br/>OR D"]
    D --> E{"DE = 0?"}
    E -- "Yes" --> R2["RET"]
    E -- "No" --> F["INC DE<br/>A = (DE)"]
    F --> G{"BIT 5,A?"}

    G -- "Set<br/>Explosion" --> X0["UPDATE_EXPLOSION"]
    G -- "Clear" --> H["SELECT_OBJECT_DRAW_DATA"]
    H --> I{"BIT 4,(IX+VBMR)?"}

    I -- "Clear<br/>Normal vector object" --> N0["SYSTEM VWRITR<br/>Write current vector position"]
    N0 --> N1{"BIT 7,(IX+VBXCHK)?"}
    N1 -- "Set" --> N2["HANDLE_VECTOR_LIMIT"]
    N2 --> N3["Boundary-limit handling<br/>select / apply constrained movement"]
    N3 --> N4["Continue to position checks"]
    N1 -- "Clear" --> N5["Select OBJECT_VECTOR_LEFT<br/>or OBJECT_VECTOR_RIGHT<br/>from low 3 bits of VBSTAT"]
    N5 --> N6["SYSTEM VECT<br/>Apply object movement vector"]
    N6 --> N4["Position / boundary checks"]
    N4 --> N7{"BIT 3,(IX+VBYCHK)?"}
    N7 -- "Set" --> N8["DEACTIVATE_VECTOR_OBJECT<br/>RES 7,(IX+VBSTAT)"]
    N7 -- "Clear" --> N9{"BIT 3,(IX+VBXCHK)?"}
    N9 -- "Clear" --> N10["MOVE_VECTOR_RELATIVE"]
    N9 -- "Set" --> N8

    I -- "Set<br/>Target object" --> T0["UPDATE_TARGET_OBJECT"]
    T0 --> T1["RES 4,(IX+VBMR)<br/>Clear target/movement marker"]
    T1 --> T2["A = VBSTAT & $07"]
    T2 --> T3{"A < $02?"}
    T3 -- "Yes" --> M["MOVE_VECTOR_RELATIVE"]
    T3 -- "No" --> T4["Save target state in B"]
    T4 --> T5{"GAME_FLAGS bit 0?"}
    T5 -- "Set" --> T9["FINISH_TARGET_UPDATE"]
    T5 -- "Clear" --> T6{"GAME_FLAG_MISSILE set?"}
    T6 -- "Yes" --> T7["WRITE_MISSILE_SOUND<br/>EMUSIC + indexed MISSILE_SOUND_TABLE"]
    T6 -- "No" --> T8{"Target state = $04?"}
    T8 -- "Yes" --> T10["BMUSIC<br/>Play boat / score music"]
    T8 -- "No" --> T9
    T7 --> T9
    T10 --> T9
    T9 --> M

    M["MOVE_VECTOR_RELATIVE<br/>IN A,(INTST)<br/>SYSTEM VWRITR"] --> M1{"Low 3 bits of VBSTAT != 0?"}
    M1 -- "Yes" --> M2["RET"]
    M1 -- "No" --> M3["IN A,(INTST)<br/>Check vector interrupt state"]
    M3 --> M4{"A = 0?"}
    M4 -- "Yes" --> M5["RET"]
    M4 -- "No" --> M6["SET 7,(IX+VBXCHK)<br/>Request X-boundary check"]
    M6 --> R3["RET"]

    X0 --> X1["EX DE,HL<br/>DEC HL<br/>DEC (HL)"]
    X1 --> X2{"Animation timer reached 0?"}
    X2 -- "No" --> X3["DRAW_EXPLOSION_FRAME"]
    X2 -- "Yes" --> X4["RES 7,(HL)<br/>Deactivate explosion object"]
    X4 --> X5["RES 0,(GAME_FLAGS)<br/>Clear explosion-related game flag"]
    X5 --> R4["RET"]

    X3 --> X6["Select explosion draw data<br/>alternate frame when required"]
    X6 --> X7["Read object X/Y high bytes"]
    X7 --> X8["Select SEAWOLF_EXPLOSION_DRAW_DATA<br/>or ALT_EXPLOSION_DRAW_DATA"]
    X8 --> X9["Set XPAND from VBOAL<br/>OUT (XPAND),A"]
    X9 --> X10["SYSTEM WRITR<br/>Draw explosion frame"]
    X10 --> R5["RET"]

    N10 --> Z["EXIT"]
    N8 --> Z
    M2 --> Z
    M5 --> Z
    R3 --> Z
    R4 --> Z
    R5 --> Z
    R1 --> Z
    R2 --> Z

    Z["Return to IM2 caller<br/>then UPDATE_RELOAD_TIMERS → UPDATE_SPAWN_TIMERS → SELECT_NEXT_OBJECT"]

    classDef normal fill:#e8f5e9,stroke:#388e3c,color:#111;
    classDef target fill:#fff8e1,stroke:#f9a825,color:#111;
    classDef explosion fill:#ffebee,stroke:#c62828,color:#111;
    classDef common fill:#e3f2fd,stroke:#1565c0,color:#111;
    classDef exit fill:#eeeeee,stroke:#555,color:#111;

    class I,N0,N1,N2,N3,N4,N5,N6,N7,N8,N9,N10 normal;
    class T0,T1,T2,T3,T4,T5,T6,T7,T8,T9,T10 target;
    class X0,X1,X2,X3,X4,X5,X6,X7,X8,X9,X10 explosion;
    class A,B,C,D,E,F,G,H,M,M1,M2,M3,M4,M5,M6 common;
    class R1,R2,R3,R4,R5,Z exit;
